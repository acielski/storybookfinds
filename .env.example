# Copy this file to .env.local to test Supabase locally.
# In Vercel, set these names in Settings → Environment Variables instead.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# The existing expense/ledger app uses only this publishable key.

# Optional: enable one username alias for your shop owner account.
# Server-only: the login email is never included in the public app configuration.
SHOP_USERNAME=storybookfinds
SHOP_LOGIN_EMAIL=YOUR_EXISTING_APP_LOGIN_EMAIL

# For the separate development Supabase project only:
# APP_ENV=development
# PRODUCTION_SUPABASE_URL=https://YOUR_LIVE_PROJECT.supabase.co
# SUPABASE_URL must be the DIFFERENT development project URL.

# Whatnot shop integration: server-only, never prefix any of these with VITE_.
# Leave blank to keep using the existing expense/CSV workflow.
WHATNOT_API_TOKEN=
WHATNOT_SELLER_ID=
WHATNOT_WORKSPACE_OWNER_ID=

# Optional unattended daily sync and signed webhook inbox.
# The legacy Supabase service_role JWT is used ONLY by the owner-pinned worker.
# Never replace SUPABASE_PUBLISHABLE_KEY with this credential.
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
WHATNOT_WEBHOOK_SECRET=

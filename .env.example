# Copy this file to .env.local to test Supabase locally.
# In Vercel, set these names in Settings → Environment Variables instead.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# No service-role key, secret key, or database password is needed by this app.

# Optional: enable one username alias for your shop owner account.
# Server-only: the login email is never included in the public app configuration.
SHOP_USERNAME=storybookfinds
SHOP_LOGIN_EMAIL=YOUR_EXISTING_APP_LOGIN_EMAIL
